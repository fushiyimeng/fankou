@*
    牌局记录：最新在最上面（靠数组倒序，不依赖滚动条定位）。
*@

<div class="overlay">
    <div class="dialog log-dialog">
        <h2 class="dialog-title">牌局记录</h2>

        <div class="log-list">
            @if (Log.Count == 0)
            {
                <div class="log-empty">还没有记录</div>
            }
            else
            {
                @for (var i = Log.Count - 1; i >= 0; i--)
                {
                    <div class="log-line">@Log[i]</div>
                }
            }
        </div>

        <div class="dialog-actions">
            <button class="btn primary" @onclick="() => OnClose.InvokeAsync()">关闭</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<string> Log { get; set; } = [];

    [Parameter] public EventCallback OnClose { get; set; }
}
