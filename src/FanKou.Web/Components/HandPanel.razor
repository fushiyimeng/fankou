@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    手牌区。位置全部按桌面版 HandPanel 的算法算好之后用绝对定位摆出来，
    所以"选中往上浮、顶部预留浮起空间"的行为和桌面版一模一样。
*@

<div class="hand" @ref="_host" style="height:@(_height)px">
    @foreach (var slot in _slots)
    {
        var card = slot.Card;
        var selected = Selected.Contains(card.Id);
        var locked = LockedIds.Contains(card.Id);
        var marked = MarkedIds.Contains(card.Id);
        var clickable = Interactive && !locked;

        <div class="hand-card @(selected ? "selected" : "") @(locked ? "locked" : "") @(marked ? "marked" : "") @(clickable ? "clickable" : "")"
             style="left:@(slot.X)px;top:@(slot.Y)px;width:@(slot.Width)px;height:@(slot.Height)px;z-index:@(slot.Z);--raise:@(_raise)px"
             @onclick="() => Click(card, clickable)">
            @if (Skin is { } skin && skin.UrlFor(card) is { } url)
            {
                <img class="card-img" src="@url" alt="@CardText.Format(card)" draggable="false" />
            }
            else
            {
                <span class="card-missing">@CardText.Format(card)</span>
            }

            @if (locked)
            {
                <span class="card-lock" title="叫主明牌，不能扣">🔒</span>
            }
        </div>
    }
</div>

@code {
    /// <summary>已经排好序的手牌（调用方用 CardSorter.ForDisplay 排）。</summary>
    [Parameter] public IReadOnlyList<Card> Cards { get; set; } = [];

    [Parameter] public CardAssetSet? Skin { get; set; }

    [Parameter] public HashSet<int> Selected { get; set; } = [];

    /// <summary>不能选的牌（换底时的叫主明牌）。</summary>
    [Parameter] public HashSet<int> LockedIds { get; set; } = [];

    /// <summary>加蓝边的牌（换底时"这几张是锅底来的"）。</summary>
    [Parameter] public HashSet<int> MarkedIds { get; set; } = [];

    /// <summary>能不能点。不是你的出牌回合时关掉。</summary>
    [Parameter] public bool Interactive { get; set; } = true;

    /// <summary>强制行数（换底对话框固定 2 行）。null 表示按宽度自适应。</summary>
    [Parameter] public int? RowsOverride { get; set; }

    [Parameter] public EventCallback<Card> OnToggle { get; set; }

    private ElementReference _host;
    private IJSObjectReference? _observer;
    private DotNetObjectReference<HandPanel>? _self;

    private double _width;
    private int _height = 196;
    private int _raise = 20;
    private List<HandSlot> _slots = [];

    protected override void OnParametersSet() => Rebuild();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        _observer = await JS.InvokeAsync<IJSObjectReference>("fankou.observeSize", _host, _self);
    }

    [JSInvokable]
    public void OnResize(double width, double height)
    {
        if (Math.Abs(width - _width) < 0.5)
        {
            return;
        }

        _width = width;
        Rebuild();
        StateHasChanged();
    }

    private void Rebuild()
    {
        // 还没量到的时候先按一个常见宽度摆，量到之后 JS 会立刻回调重排。
        var width = _width > 0 ? (int)_width : 900;
        var rows = RowsOverride ?? (width < 560 ? 3 : width < 900 ? 2 : 1);

        _height = HandLayout.HeightForRows(rows);
        var metrics = HandLayout.Compute(_height, rows, Cards.Count);
        _raise = metrics.Raise;
        _slots = HandLayout.Layout(Cards, width, metrics);
    }

    private async Task Click(Card card, bool clickable)
    {
        if (!clickable)
        {
            return;
        }

        await OnToggle.InvokeAsync(card);
    }

    public async ValueTask DisposeAsync()
    {
        if (_observer is not null)
        {
            try { await _observer.InvokeVoidAsync("dispose"); } catch { }
            try { await _observer.DisposeAsync(); } catch { }
        }

        _self?.Dispose();
    }
}
